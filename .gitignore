# Composer files
composer.phar
vendor/

# Local configs
config/autoload/*.local.php

# Binary gettext files
*.mo

# Data
data/logs/
data/cache/
data/sessions/
data/tmp/
temp/

#Doctrine 2
data/DoctrineORMModule/Proxy/
data/DoctrineORMModule/cache/

# Legacy ZF1
demos/
extras/documentation

*.gpg

.env

.DS_Store
.idea/

# Used to help with reading and writing 1p env file
create1p.js
withRefs.js
noteTemplate.json
# Production sync credentials
scripts/.env.sync

# Dumps and archives the sync script produces. dump.sql.gz is the tracked
# sample the db image seeds from; everything else here is pulled from
# production and must never be committed.
db/dump/*
!db/dump/dump.sql.gz

# User resources imported from WACS/DCS at run time. Volume-backed in
# production, bind mounted in development, and never in the repository - the
# directory is recreated by the sync script or by the application itself.
php/htdocs/webapp/www/app/Storage/Resources/

# db/backup holds the backup scripts and, in development, the backups they
# write. Ignore everything there except the scripts, so no new backup format
# has to be added here later.
db/backup/*
!db/backup/*.sh
