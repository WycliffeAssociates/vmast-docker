# Nothing from dump/ belongs in the image: the tracked sample is mounted by
# compose.local.yml in development, and a production dump here would bake real
# user data into a distributable image.
dump/

# Written backups are data; only the scripts belong in the image.
# Note: no "backup/*/" here - Docker cleans the trailing slash off ignore
# patterns, turning it into backup/* and excluding the scripts as well.
backup/*.sql.gz
backup/*.gpg
backup/counter
backup/dater
