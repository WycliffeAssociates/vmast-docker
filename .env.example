DEPLOY_ENV="development" # production/development
APP_URL="http://localhost/"
APP_EMAIL="example@mail.com"
APP_PREFIX="vm_"
APP_TYPE="local" # local/remote
APP_MAINTENANCE="false" # true/false
APP_MAINTENANCE_IPS="127.0.0.1"
MAIL_HOST="smtp.example.com"
MAIL_NAME="Mr. Smith"
MAIL_FROM="wa_noreply@example.com"
MAIL_USER="wa_noreply@example.com"
MAIL_PASS="password"
MAIL_PORT=25
# comment
MAIL_APP="/usr/sbin/sendmail -bs"
SSL_CRT="/path/to/example.com.crt"
SSL_KEY="/path/to/example.com.key"
SSL_CA="/path/to/root/ca.crt"

DB_HOST="db"
DB_NAME="vmast"
DB_USER="user"
DB_PASS="password"
DB_ROOT_PASSWORD="password"

REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_DB=1

RABBITMQ_HOST="rabbitmq"
RABBITMQ_PORT=5672
RABBITMQ_USER="user"
RABBITMQ_PASS="password"
RABBITMQ_QUEUE="queue"

MAIN_HOST="localhost"
# Host port published for web (nginx); override on shared hosts.
WEB_PORT=80
# Port browsers use for the chat socket. nginx serves it on the site's own
# port, so this matches the port people reach the site on: WEB_PORT locally,
# 443 behind Cloudflare or Traefik.
SOCKET_PORT=80

TURNSTILE_SITE_KEY="public_key"
TURNSTILE_SECRET="secret_key"

SENTRY_DSN="https://public_key@glitchtip.example.org/1"
SENTRY_DSN_JS="https://public_key@glitchtip.example.org/2"

LOG_ROCKET="project_name"

WACS_CLIENT_ID="application_client_id_from_wacs"
WACS_CLIENT_SECRET="application_client_secret_from_wacs"
DCS_CLIENT_ID="application_client_id_from_dcs"
DCS_CLIENT_SECRET="application_client_secret_from_dcs"
WACS_SERVER="https://content.bibletranslationtools.org/api/v1"
DCS_SERVER="https://git.door43.org/api/v1"
WACS_CATALOG_URL="https://api.bibletranslationtools.org/v3/catalog.json"
DCS_CATALOG_URL="https://api.door43.org/v3/catalog.json"
QA_GUIDE_URL="https://v-raft.com/api/rubric/"
BC_URL="https://content.bibletranslationtools.org/WycliffeAssociates/en_bc/archive/master.zip"
