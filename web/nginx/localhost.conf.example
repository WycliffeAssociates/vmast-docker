# Upgrade the socket's connection to a WebSocket only when the browser asks.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    #listen 443 ssl http2;
    
    server_name localhost;
    
    root "/usr/share/nginx/html/public";

    index index.html index.htm index.php;

    charset utf-8;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # The chat socket (node) is served on the site's own host and port, so
    # browsers reach it wherever they reach the site - through Cloudflare,
    # Traefik or directly - and node publishes no port of its own. ^~ keeps
    # the regex locations below from claiming these requests.
    location ^~ /socket.io/ {
        # Resolve node at request time through Docker's DNS, not once at
        # startup: nginx then starts even if node is not up yet, and follows
        # node to its new address when the container is recreated.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $node http://node:8001;
        proxy_pass $node;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # socket.io pings every 25s; allow a few missed pings before closing.
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # Both go to the container's log (`docker logs`): the requests to stdout,
    # in nginx.conf's "main" format, and errors to stderr.
    access_log /dev/stdout main;
    error_log  /dev/stderr error;

    sendfile off;

    client_max_body_size 600m;

    location ~ \.php$ {
        try_files $uri = 404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass php:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;

        fastcgi_intercept_errors off;
        fastcgi_buffer_size 16k;
        fastcgi_buffers 4 16k;

        fastcgi_connect_timeout 600;
        fastcgi_send_timeout 600;
        fastcgi_read_timeout 600;
    }

    location ~ /\.ht {
        deny all;
    }

    #ssl_certificate     /etc/nginx/ssl/example.com.crt;
    #ssl_certificate_key /etc/nginx/ssl/example.com.key;
}