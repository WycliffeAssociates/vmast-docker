.PHONY: run local test test-unit schema

local:
	docker compose -f docker-compose.yml -f compose.local.yml up --watch

# Tests run in the php image with the working tree mounted, so dev dependencies
# land in the (git-ignored) host vendor/ and never in the image. Integration
# tests get a throwaway MariaDB (compose.test.yml) that is removed afterwards.
TEST_COMPOSE = docker compose -f compose.test.yml

test:
	$(TEST_COMPOSE) run --rm php-test sh -c "composer install -q && vendor/bin/phpunit"; \
	status=$$?; $(TEST_COMPOSE) down -v >/dev/null 2>&1; exit $$status

test-unit:
	$(TEST_COMPOSE) run --rm --no-deps php-test sh -c "composer install -q && vendor/bin/phpunit --testsuite Unit"

# Structure of the running dev database (no data) for the integration tests.
# Run after any schema change. The sandbox line newer mariadb-dump writes breaks
# older clients, and AUTO_INCREMENT counters would only add churn.
schema:
	docker compose exec -T db sh -c 'mariadb-dump -u"$$MYSQL_USER" -p"$$MYSQL_PASSWORD" --no-data --no-tablespaces --skip-comments --skip-dump-date --skip-add-drop-table --skip-lock-tables "$$MYSQL_DATABASE"' > db/schema.sql.tmp \
	&& { echo "-- Structure of the vmast database, without data. Integration tests load it."; \
	     echo "-- Generated by 'make schema' from the dev database; regenerate after a schema change."; \
	     sed -E -e '/enable the sandbox mode/d' -e 's/ AUTO_INCREMENT=[0-9]+//' db/schema.sql.tmp; } > db/schema.sql; \
	status=$$?; rm -f db/schema.sql.tmp; exit $$status
