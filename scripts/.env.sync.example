# Production host, reached over SSH. Both the database dump and the asset
# tarball are produced on that machine, so nothing but SSH must be reachable.
PROD_SSH_HOST="203.0.113.10"
PROD_SSH_PORT="22"
# Optional; omit to use the agent or the default key
PROD_SSH_KEY=""

# Production database, as addressed FROM the production host - so 127.0.0.1 is
# right when MySQL runs alongside the app. This is MySQL 5.5, and the dump is
# taken with that server's own mysqldump.
PROD_DB_HOST="127.0.0.1"
PROD_DB_PORT="3306"
PROD_DB_NAME="vmast"
# Not a secret, so it lives here; the password is asked for at run time.
PROD_DB_USER="readonly_user"

# Absolute path on the production host to the user-created assets directory.
# Its parent is what the tarball is built relative to, so the archive contains
# a top-level source/ entry.
PROD_ASSETS_PATH="/var/www/html/app/Templates/Default/Assets/source"

# Absolute path on the production host to the fonts directory. Only the
# admin-uploaded SUN.woff and BackSUN.woff are taken from it.
PROD_FONTS_PATH="/var/www/html/app/Templates/Default/Assets/fonts"

# Deliberately absent: PROD_SSH_USER, PROD_SSH_PASS and PROD_DB_PASS.
# The script asks for them at run time. Do not add them here as empty strings -
# sourcing this file would then overwrite anything you had exported in the
# environment. Set them in the environment only for an unattended run:
#
#   PROD_SSH_USER=deploy PROD_DB_PASS=... \
#     ./scripts/sync-from-production.sh --db-only -y
